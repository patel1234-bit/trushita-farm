---
import BaseLayout from "../layouts/BaseLayout.astro";
import OilCalculator from "../components/OilCalculator.jsx";
---

<BaseLayout title="Monthly Oil Calculator | Trushita Natural Food" currentPage="calculator">
  <section class="py-12 bg-zinc-50 border-b border-zinc-200 bg-grid-pattern">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-sm border border-emerald-200">
        Smart Kitchen Planning
      </span>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-black mt-3 mb-2">
        Monthly Family Cooking Oil Calculator
      </h1>
      <p class="text-xs sm:text-sm text-zinc-600 max-w-xl mx-auto">
        Nutritionists recommend rotating between Groundnut, Mustard, and Sesame oils for a healthy balance of MUFA, PUFA, and Omega fatty acids.
      </p>
    </div>
  </section>

  <section class="py-14 bg-white border-b border-zinc-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <OilCalculator client:load />
    </div>
  </section>

  <section class="py-14 bg-zinc-50 border-b border-zinc-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-black mb-5 text-center">Why Rotate Multiple Cold-Pressed Oils?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 rounded-sm border border-zinc-200">
          <h3 class="font-bold text-zinc-900 mb-1">🥜 Groundnut (60%)</h3>
          <p class="text-zinc-600 leading-relaxed">High MUFA stability makes it ideal for everyday Indian sabzi, sautéing, and crisp puris.</p>
        </div>
        <div class="bg-white p-4 rounded-sm border border-zinc-200">
          <h3 class="font-bold text-zinc-900 mb-1">🌾 Yellow Mustard (30%)</h3>
          <p class="text-zinc-600 leading-relaxed">Rich in natural Omega-3 and allyl isothiocyanate for flavorful dal tadka and traditional pickles.</p>
        </div>
        <div class="bg-white p-4 rounded-sm border border-zinc-200">
          <h3 class="font-bold text-zinc-900 mb-1">🌱 White Sesame (10%)</h3>
          <p class="text-zinc-600 leading-relaxed">Packed with Sesamin antioxidants, perfect for chutneys, South Indian tempering, and winter wellness.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
