---
import BaseLayout from "../layouts/BaseLayout.astro";
import LabReportVerifier from "../components/LabReportVerifier.jsx";
import { BRAND_INFO } from "../data/catalog.js";
---

<BaseLayout title="Verify Batch Purity & FAQs | Trushita Natural Food" currentPage="lab-reports">
  <section class="py-12 bg-zinc-50 border-b border-zinc-200 bg-grid-pattern">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-sm border border-emerald-200">
        Honest Batch Traceability
      </span>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-black mt-3 mb-2">
        Don&apos;t Just Trust Us. Verify Our Purity.
      </h1>
      <p class="text-xs sm:text-sm text-zinc-600 max-w-2xl mx-auto">
        Every batch pressed at {BRAND_INFO.legalName} ({BRAND_INFO.shortLocation}) carries an individual code linking seed origin, 12 RPM wood-ghani extraction, and FSSAI compliant packaging standards ({BRAND_INFO.fssai}).
      </p>
    </div>
  </section>

  <section class="py-14 bg-white border-b border-zinc-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <LabReportVerifier client:load />
    </div>
  </section>

  <!-- Static Purity FAQs (0 KB JS) -->
  <section class="py-14 bg-zinc-50 border-b border-zinc-200">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-extrabold text-black tracking-tight">Purity, Harvesting &amp; Quality FAQs</h2>
      </div>

      <div class="space-y-3 text-sm">
        <details class="group bg-white p-5 rounded-sm border border-zinc-200 cursor-pointer" open>
          <summary class="font-bold text-zinc-900 flex justify-between items-center list-none text-xs sm:text-sm">
            <span>Why may Trushita cold-pressed oil contain light natural sediment at the bottom?</span>
            <span class="transition group-open:rotate-180 text-zinc-400">▼</span>
          </summary>
          <p class="text-xs text-zinc-600 mt-3 leading-relaxed">
            Fine seed particles that settle naturally at the base are the signature of authentic unrefined oil. Unlike factory oils stripped via chemical gums and centrifuges, our 48-hour gravity settling and cotton-cloth filtration preserve delicate micronutrients.
          </p>
        </details>

        <details class="group bg-white p-5 rounded-sm border border-zinc-200 cursor-pointer">
          <summary class="font-bold text-zinc-900 flex justify-between items-center list-none text-xs sm:text-sm">
            <span>When are Trushita Gujarat groundnuts harvested?</span>
            <span class="transition group-open:rotate-180 text-zinc-400">▼</span>
          </summary>
          <p class="text-xs text-zinc-600 mt-3 leading-relaxed">
            There is one primary Saurashtra peanut harvest per year in November. We procure fresh A1-grade G20 groundnut pods cleanly and store whole dried pods responsibly until slow wooden-ghani pressing.
          </p>
        </details>

        <details class="group bg-white p-5 rounded-sm border border-zinc-200 cursor-pointer">
          <summary class="font-bold text-zinc-900 flex justify-between items-center list-none text-xs sm:text-sm">
            <span>Why do pure wood-pressed oils have a stronger natural aroma and golden hue?</span>
            <span class="transition group-open:rotate-180 text-zinc-400">▼</span>
          </summary>
          <p class="text-xs text-zinc-600 mt-3 leading-relaxed">
            Refined oils undergo chemical deodorization and acid-clay bleaching, stripping their natural fragrance and pigments. Trushita preserves the genuine nutty aroma of groundnuts and natural pungency of mustard seeds so food tastes alive and authentic.
          </p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
