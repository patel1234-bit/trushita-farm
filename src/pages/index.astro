---
import BaseLayout from "../layouts/BaseLayout.astro";
import GhaniSimulator from "../components/GhaniSimulator.jsx";
import ProductStore from "../components/ProductStore.jsx";
import OilPairingStudio from "../components/OilPairingStudio.jsx";
import { withBase } from "../lib/paths.js";
---

<BaseLayout title="Trushita Natural Food | Pure Wood-Pressed Oils & Farm Purity" currentPage="home">
  <!-- Hero Section (Static Copy + Interactive Cutaway Wood-Ghani Oil Pour) -->
  <section class="relative pt-12 pb-16 overflow-hidden bg-zinc-50 border-b border-zinc-200 bg-grid-pattern">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-sm bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold mb-5 shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
            <span>100% Traditional Wood Ghani (Lakdi Kolhu)</span>
            <span class="text-zinc-400">•</span>
            <span>Zero Hexane Solvents</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-black mb-5 leading-[1.12]">
            Pure Cold-Pressed Oils <br />
            <span class="text-emerald-600">Sourced Directly From Gujarat Farms.</span>
          </h1>

          <p class="text-sm sm:text-base text-zinc-600 mb-6 leading-relaxed max-w-2xl">
            Commercial edible oils are chemically refined and washed with petroleum solvents.
            <strong>Trushita Oil</strong> is slowly crushed in traditional wooden ghanis at 12 RPM — preserving natural vitamin E, authentic aroma, and zero chemicals.
          </p>

          <div class="flex flex-wrap items-center gap-3 mb-8">
            <a href={withBase("/products")} class="px-5 py-3 rounded-sm bg-black hover:bg-zinc-800 text-white font-bold text-xs shadow-sm transition-all transform hover:-translate-y-0.5 flex items-center gap-2">
              <span>Explore Fresh Oils Store</span>
              <span>→</span>
            </a>
            <a href={withBase("/lab-reports")} class="px-5 py-3 rounded-sm bg-white hover:bg-zinc-100 text-zinc-800 font-bold text-xs border border-zinc-300 transition-all flex items-center gap-2 shadow-xs">
              <span>Verify NABL Batch Lab Report</span>
            </a>
            <a href={withBase("/calculator")} class="px-5 py-3 rounded-sm bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold text-xs border border-emerald-200 transition-all">
              Monthly Oil Calculator
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-zinc-200">
            <div class="bg-white p-3.5 rounded-sm border border-zinc-200 shadow-2xs">
              <span class="block text-2xl font-black text-emerald-700">12 RPM</span>
              <span class="text-[11px] text-zinc-500 font-medium">Slow Wood Press</span>
            </div>
            <div class="bg-white p-3.5 rounded-sm border border-zinc-200 shadow-2xs">
              <span class="block text-2xl font-black text-emerald-700">0.0%</span>
              <span class="text-[11px] text-zinc-500 font-medium">Chemical Solvents</span>
            </div>
            <div class="bg-white p-3.5 rounded-sm border border-zinc-200 shadow-2xs">
              <span class="block text-2xl font-black text-zinc-900">100%</span>
              <span class="text-[11px] text-zinc-500 font-medium">Gujarat Oilseeds</span>
            </div>
            <div class="bg-white p-3.5 rounded-sm border border-zinc-200 shadow-2xs">
              <span class="block text-2xl font-black text-emerald-700">NABL</span>
              <span class="text-[11px] text-zinc-500 font-medium">Lab Certified Clean</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <GhaniSimulator client:visible />
        </div>

      </div>
    </div>
  </section>

  <!-- Flowing Oil Ribbon Strip (Static Editorial Banner) -->
  <div class="bg-zinc-950 text-white py-3.5 border-b border-zinc-800 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-center sm:justify-between gap-4 text-[11px] font-semibold tracking-wider uppercase">
      <span class="inline-flex items-center gap-2 text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        Single-Origin Saurashtra Groundnuts
      </span>
      <span class="text-zinc-600 hidden sm:inline">/</span>
      <span class="inline-flex items-center gap-2 text-zinc-200">
        Babool Timber Kolhu Extraction
      </span>
      <span class="text-zinc-600 hidden sm:inline">/</span>
      <span class="inline-flex items-center gap-2 text-zinc-200">
        48-Hour Natural Gravity Settling
      </span>
      <span class="text-zinc-600 hidden sm:inline">/</span>
      <span class="inline-flex items-center gap-2 text-emerald-400">
        4-Layer Unbleached Cotton Filter
      </span>
    </div>
  </div>

  <!-- Interactive Oil Pairing Studio -->
  <section class="py-16 bg-white border-b border-zinc-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <OilPairingStudio client:visible />
    </div>
  </section>

  <!-- Why Choose Trushita (Editorial Cards with Clean SVG Line Art) -->
  <section class="py-16 bg-zinc-50 border-b border-zinc-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl tracking-tight mb-2 text-black font-extrabold">
          Why Choose Trushita?
        </h2>
        <p class="text-sm text-zinc-500">
          Crafted to meet the evolving needs of healthy kitchens with unmatched purity and trust.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-sm bg-white border border-zinc-200 hover:border-emerald-400 transition-all text-left group">
          <div class="flex items-center justify-between mb-5">
            <div class="w-11 h-11 rounded-sm bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center group-hover:bg-emerald-600 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V7l8-4v18m6 0V11l-6-3"/>
              </svg>
            </div>
            <span class="font-mono text-xs font-bold text-zinc-400">01 / FARM DIRECT</span>
          </div>
          <h3 class="text-base font-bold text-zinc-900 group-hover:text-emerald-700 transition-colors mb-2">
            Directly Sourced From Local Farms
          </h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Procured directly from native Saurashtra and Gujarat farmer cooperatives near Unjha. No middlemen, ensuring pure single-seed identity.
          </p>
        </div>

        <div class="p-6 rounded-sm bg-white border border-zinc-200 hover:border-emerald-400 transition-all text-left group">
          <div class="flex items-center justify-between mb-5">
            <div class="w-11 h-11 rounded-sm bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center group-hover:bg-emerald-600 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <span class="font-mono text-xs font-bold text-zinc-400">02 / NABL TESTED</span>
          </div>
          <h3 class="text-base font-bold text-zinc-900 group-hover:text-emerald-700 transition-colors mb-2">
            Committed Consistency
          </h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Unwavering commitment to aroma, flavor, and safety. Every single press is unbleached and verified by accredited NABL laboratories.
          </p>
        </div>

        <div class="p-6 rounded-sm bg-white border border-zinc-200 hover:border-emerald-400 transition-all text-left group">
          <div class="flex items-center justify-between mb-5">
            <div class="w-11 h-11 rounded-sm bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center group-hover:bg-emerald-600 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707"/>
              </svg>
            </div>
            <span class="font-mono text-xs font-bold text-zinc-400">03 / ECO CRAFT</span>
          </div>
          <h3 class="text-base font-bold text-zinc-900 group-hover:text-emerald-700 transition-colors mb-2">
            Climate Friendly &amp; Natural
          </h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Traditional wood-pressed extraction uses minimal power and zero chemical waste, packaged in recyclable tins and dark UV glass.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Oils Preview Island -->
  <section class="py-16 bg-white border-b border-zinc-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-sm border border-emerald-200">
            Fresh Harvest Selection
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-black tracking-tight mt-2">
            Bestselling Wood-Pressed Oils
          </h2>
        </div>
        <a href={withBase("/products")} class="inline-flex items-center gap-1.5 px-4 py-2 rounded-sm bg-black hover:bg-zinc-800 text-white text-xs font-bold transition-all self-start sm:self-auto">
          <span>View All 7 Products</span>
          <span>→</span>
        </a>
      </div>

      <ProductStore client:visible featuredOnly={true} />
    </div>
  </section>

  <!-- Dedicated Pages Explorer -->
  <section class="py-16 bg-zinc-50 border-b border-zinc-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-black mb-2">
          Explore Trushita Inside &amp; Out
        </h2>
        <p class="text-xs text-zinc-500">
          Dedicated pages to verify every batch, understand our wooden ghani craft, and plan your family's monthly oils.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href={withBase("/process")} class="group p-6 rounded-sm bg-white border border-zinc-200 hover:border-emerald-500 transition-all flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-sm border border-emerald-200">Craft &amp; Comparison</span>
            <h3 class="text-lg font-bold text-zinc-900 mt-3 mb-2 group-hover:text-emerald-700 transition-colors">5-Stage Wood-Ghani Process</h3>
            <p class="text-xs text-zinc-600 leading-relaxed mb-4">
              Walk through our traditional Babool timber crushing, 48-hour gravity settling, and refined vs. cold-pressed comparison.
            </p>
          </div>
          <span class="text-xs font-bold text-black group-hover:text-emerald-700">Inspect Process →</span>
        </a>

        <a href={withBase("/lab-reports")} class="group p-6 rounded-sm bg-white border border-zinc-200 hover:border-emerald-500 transition-all flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-white bg-emerald-600 px-2 py-0.5 rounded-sm">NABL Certified</span>
            <h3 class="text-lg font-bold text-zinc-900 mt-3 mb-2 group-hover:text-emerald-700 transition-colors">Batch Lab Report Verifier</h3>
            <p class="text-xs text-zinc-600 leading-relaxed mb-4">
              Enter your bottle's batch code to inspect independent NABL lab test results for zero hexane, aflatoxin, and free fatty acids.
            </p>
          </div>
          <span class="text-xs font-bold text-black group-hover:text-emerald-700">Verify a Batch →</span>
        </a>

        <a href={withBase("/calculator")} class="group p-6 rounded-sm bg-white border border-zinc-200 hover:border-emerald-500 transition-all flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-sm border border-emerald-200">Smart Planner</span>
            <h3 class="text-lg font-bold text-zinc-900 mt-3 mb-2 group-hover:text-emerald-700 transition-colors">Monthly Kitchen Oil Calculator</h3>
            <p class="text-xs text-zinc-600 leading-relaxed mb-4">
              Calculate your family's ideal monthly blend of Groundnut, Mustard, and Sesame oils based on household size and cooking style.
            </p>
          </div>
          <span class="text-xs font-bold text-black group-hover:text-emerald-700">Open Calculator →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Marketplaces Section -->
  <section id="marketplaces" class="py-14 bg-white border-b border-zinc-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl tracking-tight mb-2 text-black font-extrabold">
        You Can Find Us At
      </h2>
      <p class="text-xs text-zinc-500 mb-8">
        Available across India's leading trusted retail and wholesale platforms:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
        <a href="https://www.amazon.in/s?k=trushita+cold+pressed+oil" target="_blank" rel="noopener noreferrer" class="group p-5 rounded-sm bg-zinc-50 border border-zinc-200 hover:border-zinc-300 shadow-2xs hover:shadow-xs transition-all flex flex-col items-center">
          <div class="w-10 h-10 rounded-sm bg-white border border-zinc-200 flex items-center justify-center mb-3 text-zinc-900 font-black text-sm">A</div>
          <h3 class="text-sm font-bold text-zinc-900 group-hover:text-black mb-2">Amazon India</h3>
          <span class="px-3 py-1 rounded-sm bg-black text-white text-[10px] font-semibold group-hover:bg-zinc-800 transition-colors">Shop on Amazon →</span>
        </a>

        <a href="https://www.flipkart.com/search?q=trushita+cold+pressed+oil" target="_blank" rel="noopener noreferrer" class="group p-5 rounded-sm bg-zinc-50 border border-zinc-200 hover:border-zinc-300 shadow-2xs hover:shadow-xs transition-all flex flex-col items-center">
          <div class="w-10 h-10 rounded-sm bg-white border border-zinc-200 flex items-center justify-center mb-3 text-zinc-900 font-black text-sm">F</div>
          <h3 class="text-sm font-bold text-zinc-900 group-hover:text-black mb-2">Flipkart</h3>
          <span class="px-3 py-1 rounded-sm bg-black text-white text-[10px] font-semibold group-hover:bg-zinc-800 transition-colors">Shop on Flipkart →</span>
        </a>

        <a href="https://www.indiamart.com/tattvam-agriexport/" target="_blank" rel="noopener noreferrer" class="group p-5 rounded-sm bg-zinc-50 border border-zinc-200 hover:border-zinc-300 shadow-2xs hover:shadow-xs transition-all flex flex-col items-center">
          <div class="w-10 h-10 rounded-sm bg-emerald-50 border border-emerald-200 flex items-center justify-center mb-3 text-emerald-700 font-black text-sm">IM</div>
          <h3 class="text-sm font-bold text-zinc-900 group-hover:text-black mb-2">IndiaMART B2B</h3>
          <span class="px-3 py-1 rounded-sm bg-emerald-600 text-white text-[10px] font-semibold group-hover:bg-emerald-700 transition-colors">Wholesale Inquiry →</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
