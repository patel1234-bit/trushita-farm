---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import NavbarIsland from "../components/NavbarIsland.jsx";
import GlobalOverlays from "../components/GlobalOverlays.jsx";
import { BRAND_INFO } from "../data/catalog.js";
import { withBase } from "../lib/paths.js";

const {
  title = "Trushita Natural Food | Pure Wood-Pressed Oils",
  description = "Trushita Natural Food LLP - Pure, unrefined wood-pressed groundnut, yellow mustard, black mustard, sesame, coconut & flaxseed oils crafted traditionally in Visnagar, Gujarat.",
  currentPage = "home"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={withBase("/trushita.svg")} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" />
  <ClientRouter />
</head>
<body class="bg-white text-zinc-900 antialiased selection:bg-emerald-100 selection:text-emerald-900">

  <!-- Static Top Announcement Bar (Zero JS) -->
  <aside aria-label="Announcement" class="bg-zinc-950 text-zinc-300 text-[11px] py-2 px-4 border-b border-zinc-800/80">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-semibold text-white">Pressed Fresh in Visnagar:</span>
        <span class="text-zinc-400 hidden sm:inline">100% Unrefined Wood-Pressed Groundnut, Mustard &amp; Sesame Oils • FSSAI {BRAND_INFO.fssai}</span>
        <span class="text-zinc-400 sm:hidden">Pure Lakdi Ghani Harvest</span>
      </div>
      <div class="flex items-center gap-3 sm:gap-4">
        <span class="hidden md:inline-flex items-center gap-1.5 text-zinc-300">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Free Shipping ≥ ₹799
        </span>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm bg-emerald-950/90 border border-emerald-800/70 text-emerald-400 font-mono font-bold text-[10px]">
          CODE: PURE10 (10% OFF)
        </span>
      </div>
    </div>
  </aside>

  <!-- Interactive Sticky Navbar Island -->
  <NavbarIsland client:load currentPage={currentPage} />

  <!-- Page Main Content -->
  <main>
    <slot />
  </main>

  <!-- Premium Brand Credibility Footer (Zero JS) -->
  <footer class="bg-zinc-950 text-zinc-400 pt-16 pb-10 border-t border-zinc-800 text-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 mb-12">

        <!-- Brand Identity & Manufacturing Facility -->
        <div class="lg:col-span-5 space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 p-1 bg-[#f3f8f5] rounded-sm border border-emerald-200/30 flex items-center justify-center">
              <img src={withBase("/trushita.svg")} alt="Trushita Natural Food Logo" class="w-full h-full object-contain" />
            </div>
            <div>
              <span class="text-base font-extrabold text-white tracking-tight block">TRUSHITA NATURAL FOOD LLP</span>
              <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-400">Back to Purity • Visnagar, Gujarat</span>
            </div>
          </div>

          <p class="text-zinc-400 text-xs max-w-md leading-relaxed">
            A traditional agricultural-heritage manufacturer crafting 100% pure, unrefined, wood-pressed edible oils in small batches near Unjha—preserving farm nutrition without chemical refining or solvents.
          </p>

          <div class="p-3.5 rounded-sm bg-zinc-900/90 border border-zinc-800 space-y-1.5 text-[11px]">
            <p class="text-zinc-200 font-semibold">Manufacturing Unit &amp; Dispatch Center:</p>
            <address class="not-italic text-zinc-400 leading-relaxed">
              {BRAND_INFO.address}
            </address>
            <div class="pt-1 flex flex-wrap items-center gap-3 text-[11px]">
              <span class="text-emerald-400 font-mono font-bold">FSSAI Lic. No: {BRAND_INFO.fssai}</span>
              <span class="text-zinc-600">•</span>
              <a href="https://trushita.farm" target="_blank" rel="noopener noreferrer" class="text-zinc-300 hover:text-emerald-400 transition-colors">
                trushita.farm
              </a>
            </div>
          </div>
        </div>

        <!-- Product Categories -->
        <div class="lg:col-span-2">
          <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3.5">Pure Oil Categories</h4>
          <ul class="space-y-2 text-xs text-zinc-400">
            <li><a href={withBase("/products")} class="hover:text-emerald-400 transition-colors">Groundnut Oil (Singtel)</a></li>
            <li><a href={withBase("/products")} class="hover:text-emerald-400 transition-colors">Yellow Mustard Oil</a></li>
            <li><a href={withBase("/products")} class="hover:text-emerald-400 transition-colors">Black Mustard Oil</a></li>
            <li><a href={withBase("/products")} class="hover:text-emerald-400 transition-colors">White &amp; Black Sesame</a></li>
            <li><a href={withBase("/products")} class="hover:text-emerald-400 transition-colors">Virgin Coconut Oil</a></li>
            <li><a href={withBase("/products")} class="hover:text-emerald-400 transition-colors">Virgin Flaxseed Oil</a></li>
          </ul>
        </div>

        <!-- Purity & Navigation -->
        <div class="lg:col-span-2">
          <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3.5">Transparency &amp; Tools</h4>
          <ul class="space-y-2 text-xs text-zinc-400">
            <li><a href={withBase("/")} class="hover:text-emerald-400 transition-colors">Farm-to-Kitchen Home</a></li>
            <li><a href={withBase("/process")} class="hover:text-emerald-400 transition-colors">Wood-Ghani 5-Stage Craft</a></li>
            <li><a href={withBase("/lab-reports")} class="hover:text-emerald-400 transition-colors">Verify Batch Purity</a></li>
            <li><a href={withBase("/calculator")} class="hover:text-emerald-400 transition-colors">Monthly Oil Calculator</a></li>
            <li><a href={withBase("/#marketplaces")} class="hover:text-emerald-400 transition-colors">Amazon, Flipkart &amp; B2B</a></li>
          </ul>
        </div>

        <!-- Connect & Policies -->
        <div class="lg:col-span-3">
          <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3.5">Connect &amp; Policies</h4>
          <ul class="space-y-2 text-xs text-zinc-400 mb-5">
            <li><a href={withBase("/policies#quality")} class="hover:text-emerald-400 transition-colors">Quality &amp; Verification Policy</a></li>
            <li><a href={withBase("/policies#shipping")} class="hover:text-emerald-400 transition-colors">Shipping, Returns &amp; Packing</a></li>
            <li><a href={withBase("/policies#privacy")} class="hover:text-emerald-400 transition-colors">Privacy &amp; Terms of Use</a></li>
          </ul>

          <div class="flex items-center gap-2.5">
            <a
              href={BRAND_INFO.socials.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="w-9 h-9 rounded-sm bg-zinc-900 border border-zinc-800 hover:border-emerald-500 text-zinc-300 hover:text-emerald-400 flex items-center justify-center transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 0 1 1.772 1.153 4.902 4.902 0 0 1 1.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 0 1-1.153 1.772 4.902 4.902 0 0 1-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 0 1-1.772-1.153 4.902 4.902 0 0 1-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 0 1 1.153-1.772A4.902 4.902 0 0 1 5.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 0 0-.748-1.15 3.098 3.098 0 0 0-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 1 1 0 10.27 5.135 5.135 0 0 1 0-10.27zm0 1.802a3.333 3.333 0 1 0 0 6.666 3.333 3.333 0 0 0 0-6.666zm5.338-3.205a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z" clip-rule="evenodd"/></svg>
            </a>
            <a
              href={BRAND_INFO.socials.facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="w-9 h-9 rounded-sm bg-zinc-900 border border-zinc-800 hover:border-emerald-500 text-zinc-300 hover:text-emerald-400 flex items-center justify-center transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd"/></svg>
            </a>
            <a
              href={BRAND_INFO.socials.youtube}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
              class="w-9 h-9 rounded-sm bg-zinc-900 border border-zinc-800 hover:border-emerald-500 text-zinc-300 hover:text-emerald-400 flex items-center justify-center transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="pt-6 border-t border-zinc-800 text-zinc-500 text-[11px] flex flex-col sm:flex-row items-center justify-between gap-2">
        <span>© 2026 {BRAND_INFO.legalName}. All Rights Reserved.</span>
        <span>Pure Wood-Pressed Oils • {BRAND_INFO.shortLocation}</span>
      </div>
    </div>
  </footer>

  <!-- Interactive Overlays Island (Cart, Auth, Admin, Orders, QuickView, Toast) -->
  <GlobalOverlays client:load />

  <!-- Subtle Lightweight Scroll Reveal Observer (ClientRouter compatible) -->
  <script is:inline>
    (function () {
      function initReveal() {
        var nodes = document.querySelectorAll('.reveal-on-scroll');
        if (!nodes.length) return;
        if (!('IntersectionObserver' in window)) {
          nodes.forEach(function (el) { el.classList.add('reveal-visible'); });
          return;
        }
        var obs = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal-visible');
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -24px 0px' });
        nodes.forEach(function (el) {
          if (!el.classList.contains('reveal-visible')) obs.observe(el);
        });
      }
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    })();
  </script>
</body>
</html>
