---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import NavbarIsland from "../components/NavbarIsland.jsx";
import GlobalOverlays from "../components/GlobalOverlays.jsx";

const { title = "Trushita Natural Food | Pure Wood-Pressed Oils", currentPage = "home" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/trushita.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" />
  <ClientRouter />
</head>
<body class="bg-white text-zinc-900 antialiased selection:bg-emerald-100 selection:text-emerald-900">

  <!-- Static Top Announcement Bar (Zero JS) -->
  <aside aria-label="Announcement" class="bg-zinc-950 text-zinc-300 text-[11px] py-2 px-4 border-b border-zinc-800/80">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-semibold text-white">Live from Visnagar:</span>
        <span class="text-zinc-400 hidden sm:inline">100% Unrefined Wood-Pressed Groundnut &amp; Mustard Batches Pressed Today</span>
        <span class="text-zinc-400 sm:hidden">Pure Lakdi Ghani Harvest</span>
      </div>
      <div class="flex items-center gap-3 sm:gap-4">
        <span class="hidden md:inline-flex items-center gap-1.5 text-zinc-300">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Free Shipping ≥ ₹799
        </span>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm bg-emerald-950/90 border border-emerald-800/70 text-emerald-400 font-mono font-bold text-[10px]">
          CODE: PURE10 (10% OFF)
        </span>
      </div>
    </div>
  </aside>

  <!-- Interactive Sticky Navbar Island -->
  <NavbarIsland client:load currentPage={currentPage} />

  <!-- Page Main Content -->
  <main>
    <slot />
  </main>

  <!-- Static Footer (Zero JS) -->
  <footer class="bg-zinc-950 text-zinc-400 pt-14 pb-10 border-t border-zinc-800 text-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
        <div class="md:col-span-2 space-y-3">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 p-0.5 bg-white rounded-sm flex items-center justify-center">
              <img src="/trushita.svg" alt="Trushita Logo" class="w-full h-full object-contain" />
            </div>
            <span class="text-base font-bold text-white tracking-tight">TRUSHITA NATURAL FOOD</span>
          </div>
          <p class="text-zinc-400 text-xs max-w-sm leading-relaxed">
            Trushita Natural Food LLP is a manufacturer of natural, wood-pressed edible oils. Operating from Visnagar, Mehsana, adjacent to the Unjha agricultural commodity trading hub.
          </p>
          <p class="text-zinc-500 text-[11px]">
            Plot No. 63, Phase-2, D.J. Industrial Estate, Opp. Matel Hotel, Kheralu Road, Visnagar, Mehsana, Gujarat - 384315
          </p>
        </div>

        <div>
          <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Explore Pages</h4>
          <ul class="space-y-1.5 text-xs text-zinc-400">
            <li><a href="/" class="hover:text-emerald-400 transition-colors">Home Overview</a></li>
            <li><a href="/products" class="hover:text-emerald-400 transition-colors">Wood-Pressed Oils Store</a></li>
            <li><a href="/process" class="hover:text-emerald-400 transition-colors">5-Stage Wood-Ghani Process</a></li>
            <li><a href="/lab-reports" class="hover:text-emerald-400 transition-colors">NABL Lab Batch Verifier</a></li>
            <li><a href="/calculator" class="hover:text-emerald-400 transition-colors">Monthly Oil Calculator</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Channels &amp; Verification</h4>
          <ul class="space-y-1.5 text-xs text-zinc-400 mb-3">
            <li><a href="/lab-reports" class="hover:text-emerald-400 transition-colors">Verify NABL Certificate</a></li>
            <li><a href="/#marketplaces" class="hover:text-emerald-400 transition-colors">Amazon / Flipkart / IndiaMART</a></li>
            <li><a href="https://www.instagram.com/trushitanaturalfood/" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">Instagram @trushitanaturalfood</a></li>
            <li><a href="https://www.youtube.com/@TrushitaNaturalfood" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">YouTube Channel</a></li>
          </ul>
        </div>
      </div>

      <div class="pt-6 border-t border-zinc-800 text-center text-zinc-500 text-[11px] flex flex-col sm:flex-row items-center justify-between gap-2">
        <span>© 2026 Trushita Natural Food LLP. All Rights Reserved.</span>
        <span>Built with Astro Islands for Instant Mobile Speed</span>
      </div>
    </div>
  </footer>

  <!-- Interactive Overlays Island (Cart, Auth, Admin, Orders, QuickView, Toast) -->
  <GlobalOverlays client:load />

</body>
</html>
